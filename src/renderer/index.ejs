<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <% if (htmlWebpackPlugin.options.isDevelopment) { %>
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self' http://localhost:<%- htmlWebpackPlugin.options.devServerPort %> ws://localhost:<%- htmlWebpackPlugin.options.devServerPort %>; script-src 'self' 'unsafe-inline' http://localhost:<%- htmlWebpackPlugin.options.devServerPort %> https://maps.googleapis.com https://*.googleapis.com; connect-src 'self' http://localhost:<%- htmlWebpackPlugin.options.devServerPort %> ws://localhost:<%- htmlWebpackPlugin.options.devServerPort %> https://blind-ministries.org https://maps.googleapis.com https://*.googleapis.com https://maps.gstatic.com; img-src 'self' data: blob: https://maps.googleapis.com https://maps.gstatic.com https://*.googleusercontent.com http://maps.google.com https://maps.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; worker-src 'self' blob:;"
    />
    <% } else { %>
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' https://maps.googleapis.com https://*.googleapis.com; connect-src 'self' https://blind-ministries.org https://maps.googleapis.com https://*.googleapis.com https://maps.gstatic.com; img-src 'self' data: blob: https://maps.googleapis.com https://maps.gstatic.com https://*.googleusercontent.com http://maps.google.com https://maps.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; worker-src 'self' blob:;"
    />
    <% } %>
    <title>RLC Blind Ministry</title>
  </head>
  <body>
    <div id="root"></div>
  </body>
</html>
