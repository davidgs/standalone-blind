# Copy to .env (no spaces around =). Restart app after changes.
BLIND_SECRET=your_api_signing_secret
BLIND_PASSWD=your_mailbox_password
GOOGLE_MAPS_API_KEY=your_google_maps_key

# SMTP (optional). Use 587 if 465 auth fails after server relay changes.
# SMTP_HOST=blind-ministries.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=routing@blind-ministries.org
